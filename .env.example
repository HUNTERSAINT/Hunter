# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set a server ID so slash commands register instantly while developing
DISCORD_GUILD_ID=
# Optional fallback channel for research reports (admins can set channels with /admin config channel)
RESEARCH_CHANNEL_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Only used for the cost estimates in /admin analytics (USD per 1M tokens, USD per web search)
OPENAI_INPUT_COST_PER_M=2
OPENAI_OUTPUT_COST_PER_M=8
OPENAI_WEB_SEARCH_COST=0.025

# Railway provides these when you add the Postgres and Redis plugins
DATABASE_URL=postgresql://user:password@localhost:5432/web3jobhunters
REDIS_URL=redis://localhost:6379

# Limits (admins can override cooldown and daily limit per server with /admin config)
RESEARCH_COOLDOWN_SECONDS=120
RESEARCH_DAILY_LIMIT_PER_USER=10
RESEARCH_CACHE_DAYS=7
ASSIST_DAILY_LIMIT=30

# Scheduled web scans for new opportunities (costs OpenAI credits on every run, so off by default)
AUTO_SCAN_ENABLED=false
SCAN_CRON=0 6,18 * * *

# Optional: lets n8n or other tools push opportunities to POST /api/ingest (send it as the x-api-key header)
INGEST_API_KEY=
# Optional: error monitoring
SENTRY_DSN=

# Health and API server
PORT=3000
LOG_LEVEL=info
